# Supabase Configuration ("Simulation Experiments" Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_TABLE=school_closure_experiments

# LLM Compute Provider (Optional server default)
# On public Vercel deployments, leave OPENAI_API_KEY empty so visitors bring their own key (BYOK)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.together.xyz/v1

MODEL_LLAMA=meta-llama/Llama-3.3-70B-Instruct-Turbo
